# Supabase — project "baseafood" (ref: izpxcjtgveazjnqtzfer), lấy từ SDFactory.
# Project này giờ chỉ phục vụ MES: 11 bảng tên tiếng Việt không dấu,
# xem supabase/migrations/0001_baseafood_mes.sql và docs/supabase-setup.md.
#
# Copy file này thành `.env` (đã gitignore) rồi điền ANON KEY thật.
# Lấy key: Supabase Dashboard → Project Settings → API → Project API keys
#          → anon / publishable. TUYỆT ĐỐI KHÔNG đặt service_role key ở đây
#          (Vite nhúng mọi biến VITE_* thẳng vào bundle ai cũng đọc được).
VITE_SUPABASE_URL=https://izpxcjtgveazjnqtzfer.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mã xí nghiệp — phải khớp cột id trong bảng xi_nghiep.
VITE_SITE_ID=bsf1

# Để trống VITE_SUPABASE_ANON_KEY thì app tự chạy bằng localStorage.
