#!/bin/sh
# Cổng máy cho Baseafood MES — nguyên tắc 8 của ai-simple-product-dev:
# invariant tự giác là invariant sẽ chết.
#
# Bật:      git config core.hooksPath .githooks
# Tự kiểm:  sh .githooks/pre-commit --self-test
# Bỏ qua 1 lần (chỉ khi thật sự cần):  git commit --no-verify
#
# CHẶN  : lộ khóa/URL Supabase · features import thẳng primitive · features gọi
#         localStorage/supabase · chữ nhỏ & IN HOA trong màn nghiệp vụ
# CẢNH BÁO: doc app-map có `covers:` trỏ tới file vừa sửa mà doc đứng yên ·
#         nút chỉ-icon thêm mới chưa có aria-label/title (nhắc, không chặn —
#         mẫu dò theo DÒNG nên JSX xuống dòng có thể báo nhầm)
#
# Chỉ soi DÒNG THÊM MỚI — không bắt lỗi di sản đã có trong repo.

loi=0
canh_bao=0

do_hong() { printf '\033[31m✘ %s\033[0m\n' "$1"; loi=1; }
do_nhac() { printf '\033[33m▲ %s\033[0m\n' "$1"; canh_bao=1; }

# Chuỗi ghép để chính file hook này không tự khớp mẫu của nó.
MAU_JWT='eyJ[A-Za-z0-9_-]\{20,\}'
MAU_URL='https://[a-z0-9]\{15,\}\.supabase''\.co'
MAU_NUT_ICON='size="icon'
# Policy RLS mở cho anon (giai đoạn chưa đăng nhập). Bảng mới KHÔNG được để lại.
MAU_RLS_ANON='to anon, *authenticated'

dong_them() { git diff --cached -U0 -- "$1" | grep '^+' | grep -v '^+++'; }

# ---------- self-test ----------
if [ "$1" = "--self-test" ]; then
  ok=0
  echo 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9' | grep -q "$MAU_JWT" || { echo "self-test: mẫu JWT hỏng"; ok=1; }
  echo 'https://abcdefghijklmnop.supabase.co' | grep -q "$MAU_URL" || { echo "self-test: mẫu URL hỏng"; ok=1; }
  echo 'import { Button } from "@/components/ui/button";' | grep -q '@/components/ui' || { echo "self-test: mẫu import hỏng"; ok=1; }
  echo 'class="text-xs uppercase"' | grep -q 'text-xs\|uppercase' || { echo "self-test: mẫu cỡ chữ hỏng"; ok=1; }
  echo '<Button size="icon" onClick={x}>' | grep -q "$MAU_NUT_ICON" || { echo "self-test: mẫu nút icon hỏng"; ok=1; }
  echo '<Button size="icon" aria-label="Tháng trước">' | grep -q 'aria-label\|title=' || { echo "self-test: mẫu nhãn nút hỏng"; ok=1; }
  echo '  for all to anon, authenticated' | grep -qE "$MAU_RLS_ANON" || { echo "self-test: mẫu RLS anon hỏng"; ok=1; }
  [ -f docs/app-map/README.md ] || { echo "self-test: thiếu docs/app-map/README.md"; ok=1; }
  [ "$ok" = 0 ] && echo "self-test: OK"
  exit "$ok"
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ---------- 1. Khóa / URL / .env (CHẶN) ----------
for f in $staged; do
  case "$f" in
    .env|.env.*|*/.env) [ "$f" = ".env.example" ] || do_hong "$f — file môi trường không được commit" ;;
  esac
done

for f in $staged; do
  case "$f" in .githooks/*) continue ;; esac
  them=$(dong_them "$f")
  [ -z "$them" ] && continue
  if printf '%s\n' "$them" | grep -q "$MAU_JWT"; then
    do_hong "$f — có chuỗi giống anon/service key. Không ghi khóa vào repo (docs/app-map/05-bao-mat-phan-quyen.md)"
  fi
  if printf '%s\n' "$them" | grep -q "$MAU_URL"; then
    do_hong "$f — có URL project Supabase thật. Chỉ để trống trong .env.example"
  fi
done

# ---------- 2. Ranh giới import của màn nghiệp vụ (CHẶN) ----------
for f in $staged; do
  case "$f" in src/features/*) ;; *) continue ;; esac
  them=$(dong_them "$f")
  [ -z "$them" ] && continue

  if printf '%s\n' "$them" | grep -q '@/components/ui'; then
    do_hong "$f — features chỉ được import từ @/design-system (CLAUDE.md §3)"
  fi
  if printf '%s\n' "$them" | grep -q 'localStorage\.\|from "@/lib/supabase"\|from "@/lib/db"'; then
    do_hong "$f — features không gọi localStorage/supabase/db trực tiếp, đi qua @/lib/catalogRepo (CLAUDE.md §4)"
  fi

  # Nút chỉ-icon phải nói được nó làm gì khi rê chuột (README §9). Chỉ soi dòng
  # thêm mới: một dòng `<Button size="icon…"` mà chính nó không mang aria-label
  # / title thì gần như chắc là nút câm — mở ra xem rồi bổ sung.
  if printf '%s\n' "$them" | grep -q "$MAU_NUT_ICON"; then
    cam=$(printf '%s\n' "$them" | grep "$MAU_NUT_ICON" | grep -cv 'aria-label\|title=')
    if [ "$cam" -gt 0 ] 2>/dev/null; then
      do_nhac "$f — có $cam nút chỉ-icon thêm mới chưa thấy aria-label/title trên cùng dòng. Rê chuột phải ra hướng dẫn (src/design-system/README.md §9)"
    fi
  fi

  # BalancingTable.tsx là bản in A4 — ngoại lệ có chủ đích.
  case "$f" in */BalancingTable.tsx) continue ;; esac
  if printf '%s\n' "$them" | grep -q 'text-xs\|uppercase'; then
    do_hong "$f — cấm text-xs / IN HOA trong màn nghiệp vụ (người dùng 45–60 tuổi, src/design-system/README.md §3)"
  fi
done

# ---------- 3. Doc app-map lệch code (CẢNH BÁO) ----------
for doc in docs/app-map/*.md; do
  [ -f "$doc" ] || continue
  case "$staged" in *"$doc"*) continue ;; esac   # doc đã sửa trong commit này

  covers=$(sed -n 's/^covers:[[:space:]]*//p' "$doc" | head -1 | tr ',' ' ')
  [ -z "$covers" ] && continue

  for mau in $covers; do
    mau=$(printf '%s' "$mau" | sed 's|\*\*|*|g')
    for f in $staged; do
      # shellcheck disable=SC2254
      case "$f" in
        $mau) do_nhac "$f đổi nhưng $doc không — soát lại rồi cập nhật last_verified:"; break ;;
      esac
    done
  done
done

# ---------- 4. Migration mở RLS cho anon (CẢNH BÁO) ----------
# Bảng mới để lại policy `for all to anon, authenticated using(true)` = lỗ hổng:
# anon key nằm trong bundle, ai cũng đọc/ghi được. Nhắc đưa vào diện siết RLS
# (0021 + 0047). Không CHẶN vì migration siết/rollback nhắc lại mẫu này có chủ đích.
for f in $staged; do
  case "$f" in supabase/migrations/*.sql) ;; *) continue ;; esac
  case "$f" in */0021_*|*/0047_*) continue ;; esac   # chính các file siết/rollback
  them=$(dong_them "$f")
  [ -z "$them" ] && continue
  if printf '%s\n' "$them" | grep -qE "$MAU_RLS_ANON"; then
    do_nhac "$f — có policy mở 'to anon, authenticated'. Bảng mới phải kèm siết RLS: thêm tên bảng vào 0047 (hoặc viết policy 'to authenticated'). Xem docs/app-map/05-bao-mat-phan-quyen.md"
  fi
done

# ---------- 5. ba-spec phải test được (CHẶN — skill ba-flow-logic) ----------
# Cổng máy của skill BA: ba-spec staged thiếu frontmatter / 0 AC / AC thiếu Test:/Assert
# / AC chứa component UI ⇒ chặn. Chỉ chạy khi máy có skill (máy khác/fresh clone: bỏ qua,
# không gãy commit) — bản global, không copy vào repo để tránh drift.
BA_VERIFY="$HOME/.claude/skills/ba-flow-logic/ba-verify.sh"
if [ -f "$BA_VERIFY" ] && printf '%s\n' "$staged" | grep -qiE 'ba-spec.*\.md$'; then
  if ! sh "$BA_VERIFY" --staged; then
    do_hong "ba-spec staged không qua cổng ba-verify (thiếu Test:/Assert/frontmatter hoặc AC chứa từ UI)"
  fi
fi

[ "$canh_bao" = 1 ] && echo "  (cảnh báo không chặn commit)"

if [ "$loi" = 1 ]; then
  echo ""
  echo "Commit bị chặn. Sửa xong commit lại."
  exit 1
fi
exit 0
